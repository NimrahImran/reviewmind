# Copy this file to ".env" only when you run ReviewMind on your own computer.
# On Vercel, add the same names under Project → Settings → Environment Variables.
# Never share real keys or commit them to GitHub.

# ── AI agents (required for full analysis) ─────────────────────────────
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=paste_your_key_here
# Optional: models to try, in order (comma separated)
# GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash-lite

# ── Fine-tuned sentiment model ───────────────────────────────────────
# Nothing to set: the Pulse model ships inside the repo (model/runtime) and runs in the API.
# PULSE_MODEL=off   # only if you ever want to switch it off

# ── Hire Me form → your inbox (required for the contact form) ──────────
# Use a Gmail "App password" (Google Account → Security → 2-Step Verification → App passwords)
GMAIL_USER=your-address@gmail.com
GMAIL_APP_PASSWORD=the-16-letter-app-password
# Optional: send messages to a different inbox than GMAIL_USER
# CONTACT_TO_EMAIL=inbox@example.com
